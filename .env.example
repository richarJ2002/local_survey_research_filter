# Copy to .env and fill in. Never commit .env.
# Used for polite API access only. Keys are never stored in the database.
OPENALEX_EMAIL=you@example.com
# Optional Semantic Scholar API key for higher limits.
# SEMANTIC_SCHOLAR_KEY=
# Optional OpenCitations access token; public API also works without one.
# OPENCITATIONS_TOKEN=
# Optional Elsevier Scopus credentials; a key alone does not grant API access.
# Confirm your API agreement permits local storage and export for research.
# ELSEVIER_API_KEY=
# Optional Elsevier-issued institutional access token.
# ELSEVIER_INSTTOKEN=
DEBUG=1
# DJANGO_SECRET_KEY=change-me-for-local-only
